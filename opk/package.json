{
  "name": "opk-tools",
  "private": true,
  "version": "1.0.0",
  "description": "OPK 업무 도구 — 계약서 편집기와 메일 서명 편집기 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute opk-tools --remote --file=db/schema.sql",
    "db:init:local": "wrangler d1 execute opk-tools --local --file=db/schema.sql",
    "db:example": "wrangler d1 execute opk-tools --remote --file=db/seed.example.sql",
    "db:example:local": "wrangler d1 execute opk-tools --local --file=db/seed.example.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
